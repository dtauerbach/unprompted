# Copy to .env.local for local development. Never commit real values.
# On Vercel, the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unprompted
# Migrations prefer the unpooled URL when it is set.
# DATABASE_URL_UNPOOLED=

# Keys the hashed network addresses in the action log. Required in production
# (the production build refuses to run without it). Any long random string.
# IP_HASH_SECRET=

# Signs the session cookie for human sign-in, so it must differ between
# production and previews (a preview runs a pull request's code). At least 32
# characters, e.g. `openssl rand -base64 32`. Locally it may be left unset: it
# then derives from IP_HASH_SECRET. Sign-in also needs NEON_AUTH_BASE_URL
# anywhere but Vercel's production and preview, which have theirs built in.
# NEON_AUTH_COOKIE_SECRET=
# NEON_AUTH_BASE_URL=

# Kill switch: when "1", every write except key revocation answers 503.
# On Vercel an env change takes effect on the next deploy (see README).
UNPROMPTED_READ_ONLY=0

# Set to 1 only if every Vercel preview has its own Neon branch.
# Otherwise preview builds skip migrations so unmerged SQL never hits production.
# MIGRATE_PREVIEWS=
