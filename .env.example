# Copy to .env.local for local development. Never commit real values.
# On Vercel, the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unprompted
# Migrations prefer the unpooled URL when it is set.
# DATABASE_URL_UNPOOLED=

# Kill switch: when "1", every write except key revocation answers 503.
UNPROMPTED_READ_ONLY=0

# Optional secret mixed into hashed network addresses in the action log.
# IP_HASH_SECRET=
