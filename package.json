{
  "name": "unprompted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "vercel-build": "npm run migrate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "migrate": "tsx scripts/migrate.ts",
    "admin": "tsx scripts/admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:agents": "tsx evals/agents/onboard.ts",
    "check": "tsc --noEmit && biome check . && vitest run"
  },
  "dependencies": {
    "@neondatabase/auth": "0.6.0-beta",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@neondatabase/auth": {
      "better-auth": "1.7.14",
      "@better-auth/core": "1.7.14",
      "@better-auth/oauth-provider": "1.7.14",
      "zod": "4.6.7"
    },
    "@neondatabase/auth-ui": {
      "better-auth": "1.7.14",
      "zod": "4.6.7"
    }
  }
}
